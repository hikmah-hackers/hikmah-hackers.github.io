---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---

<Base title="Page not found">
  <PageHead eyebrow="Error 404" title="NameError: page is not defined" lede="That page doesn’t exist (yet). Check the address, or head back home.">
    <div class="row" style="margin-top:28px">
      <a class="btn btn-gold" href="/">Go home <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="/lessons">See lessons</a>
    </div>
  </PageHead>
</Base>
