---
import { render } from 'astro:content';
import type { Announcement } from '../lib/content';
import { formatDate } from '../lib/dates';

interface Props {
  items: Announcement[];
  compact?: boolean;
}
const { items, compact = false } = Astro.props;
const rendered = await Promise.all(items.map(async (item) => ({ item, Content: (await render(item)).Content })));
---

{
  items.length === 0 ? (
    <div class="empty">No announcements yet.</div>
  ) : (
    <ul class:list={['news', { compact }]}>
      {rendered.map(({ item, Content }, i) => (
        <li data-reveal style={`--i:${i}`} id={item.id}>
          <div class="row head">
            <time datetime={item.data.date}>{formatDate(item.data.date, 'short')}</time>
            {item.data.pinned && <span class="chip chip-due-soon">Pinned</span>}
          </div>
          <h3>{item.data.title}</h3>
          <div class="body prose">
            <Content />
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .news li {
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .news li:first-child {
    padding-top: 8px;
  }
  .head {
    gap: 10px;
    margin-bottom: 6px;
  }
  time {
    font: 500 0.85rem var(--font-mono);
    color: var(--gold-ink);
  }
  h3 {
    margin: 0 0 6px;
  }
  .body {
    color: var(--ink-soft);
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .compact .body {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
